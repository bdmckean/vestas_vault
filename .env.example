# Database (used by docker-compose for the postgres container)
# IMPORTANT: POSTGRES_DB is the database NAME that gets created. Do NOT use the username as the database name.
# If you see "database \"retirement_user\" does not exist", fix DATABASE_URL to use the DB name (e.g. retirement_planner), not the user name.
POSTGRES_USER=retirement_user
POSTGRES_PASSWORD=your_password
POSTGRES_DB=retirement_planner
# Backend connection: same user/password; last segment must be the DATABASE name (must match POSTGRES_DB above)
DATABASE_URL=postgresql://retirement_user:your_password@db:5432/retirement_planner

# Application
ENVIRONMENT=development
DEBUG=true
# LOG_LEVEL=INFO   # optional: DEBUG, INFO, WARNING, ERROR (default: INFO, or DEBUG when DEBUG=true)

# API
API_V1_PREFIX=/api/v1

# Frontend (VITE_API_URL used for production/build; in dev, proxy uses VITE_PROXY_TARGET)
VITE_API_URL=http://localhost:8005
# When frontend runs in Docker, Vite proxies /api to the backend (default: http://backend:8000)
VITE_PROXY_TARGET=http://backend:8000
